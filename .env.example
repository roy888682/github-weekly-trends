# 로컬 실행·외부 스케줄러(Windows 작업 스케줄러, cron)용 설정 예시입니다.
# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요. (.env 는 .gitignore 에 있어 저장소에 올라가지 않습니다.)
# GitHub Actions 에서는 이 파일 대신 저장소 Secrets 를 사용합니다.

# 보내는 Gmail 주소와 받는 주소(여러 명이면 쉼표로 구분)
MAIL_FROM=
MAIL_TO=

# Gmail 앱 비밀번호 16자리 (공백은 있어도 자동 제거됩니다)
SMTP_PASSWORD=

# (선택) GitHub 개인 액세스 토큰 — 없으면 비인증 API 한도(검색 10회/분, 일반 60회/시간)로 동작
GITHUB_TOKEN=

# (선택) Claude 로 한국어 소개문 작성 — 비워 두면 저장소 설명·README 기반 템플릿 사용
ANTHROPIC_API_KEY=
